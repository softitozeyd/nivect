# Copy via scripts/setup-dev.ps1 to generate separate local passwords.
POSTGRES_DB=nivect
POSTGRES_USER=nivect
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-local-secret
REDIS_PORT=6379
MQTT_USERNAME=nivect
MQTT_PASSWORD=replace-with-local-secret
MQTT_PORT=1883
# Optional backend settings (Compose uses its internal service addresses).
BACKEND_PORT=8080
MQTT_CLIENT_ID=spring-bottle-qc-backend
MQTT_TOPIC=production/+/inspections
